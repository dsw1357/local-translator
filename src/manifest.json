{
  "manifest_version": 3,
  "name": "우클릭 로컬 번역",
  "version": "1.1.0",
  "description": "선택한 텍스트와 웹페이지를 이 PC에서 한국어로 번역합니다.",
  "permissions": ["contextMenus", "activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:39781;"
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": { "default_title": "현재 페이지를 한국어로 번역" }
}
